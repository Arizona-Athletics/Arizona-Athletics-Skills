# Copy to .env.local and fill in the // CONFIGURE_ME values.
# .env* is gitignored — only .env.example is committed.

# AWS / Cognito User Pool  (CONFIGURE_ME)
AWS_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=your-app-name
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/

# SAML IdP name as configured in Cognito  (CONFIGURE_ME)
COGNITO_SAML_PROVIDER_NAME=UAWebAuth

# Server-side only. NEVER commit a real value. NEVER prefix with NEXT_PUBLIC_.
# This template uses a confidential server client; the secret is read inside
# app/auth/*/route.ts handlers and never reaches the browser bundle.
COGNITO_CLIENT_SECRET=

# Server-only signing secret for the state parameter on the auth redirect.
# Generate with: openssl rand -base64 32
AUTH_STATE_SECRET=
