# @ua/template-hugo — Cognito + UA SAML
#
# Copy to `.env` (gitignored). Fill in via your project's AWS Console + the
# UA IT engagement process. NEVER commit real values to git.
# See /docs/AUTH.md for the full flow shape and rules.
#
# Hugo does not natively read .env at build time — these values are surfaced
# either through your deploy pipeline (rendering a /js/config.json) or by
# editing static/js/auth.js directly before publishing. Keep this file as the
# checklist of what the project needs.

# --- AWS / Cognito User Pool ----------------------------------------- CONFIGURE_ME
AWS_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=your-app-name
COGNITO_REDIRECT_URI=http://localhost:1313/auth/callback
COGNITO_LOGOUT_URI=http://localhost:1313/

# --- UA SAML provider name as configured in Cognito ----------------- CONFIGURE_ME
COGNITO_SAML_PROVIDER_NAME=UAWebAuth

# --- Server-only secret. DO NOT expose to the browser. -------------- CONFIGURE_ME
# This template ships as a static SPA and uses PKCE — it SHOULD NOT have a
# client secret. Fill in only for a confidential server-side companion.
COGNITO_CLIENT_SECRET=

# --- Adobe Typekit ID (Proxima Nova + Garamond Premier Pro) --------- CONFIGURE_ME
# Set TYPEKIT_KIT_ID and mirror it into hugo.toml [params].typekitKitId. UA
# Marcom must clear the kit before production — see /docs/TYPOGRAPHY.md.
TYPEKIT_KIT_ID=
