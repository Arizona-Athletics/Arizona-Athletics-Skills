---
// Footer — site chrome at the bottom. Brand block, link columns, social row,
// and the REQUIRED legal bottom bar.
// Tokens used: --surface, --text, --text-strong, --text-muted, --border,
// --font-sans, --space-3, --space-6, --space-8.
// Contract: docs/COMPONENTS.md#footer

interface ColumnLink {
  href: string;
  label: string;
}
interface Column {
  heading: string;
  links: ColumnLink[];
}

interface Props {
  description?: string;
  columns?: Column[];
}

const {
  description = "The official home of Arizona Athletics.",
  columns = [
    {
      heading: "Teams",
      links: [
        { href: "/football", label: "Football" },
        { href: "/basketball", label: "Basketball" },
        { href: "/baseball", label: "Baseball" },
      ],
    },
    {
      heading: "Fans",
      links: [
        { href: "/tickets", label: "Tickets" },
        { href: "/schedule", label: "Schedule" },
        { href: "/shop", label: "Shop" },
      ],
    },
    {
      heading: "About",
      links: [
        { href: "/news", label: "News" },
        { href: "/staff", label: "Staff" },
        { href: "/contact", label: "Contact" },
      ],
    },
  ],
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="ua-footer" role="contentinfo">
  <div class="ua-footer__inner">
    <div class="ua-footer__brand">
      {/* CONFIGURE_ME: replace with the official Arizona Athletics wordmark SVG. */}
      <p class="ua-footer__wordmark">ARIZONA ATHLETICS</p>
      <p class="ua-footer__desc">{description}</p>
    </div>

    <nav class="ua-footer__columns" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="ua-footer__col">
            <h4>{col.heading}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="ua-footer__legal">
    <p>
      &copy; {year} Arizona Board of Regents on behalf of the University of Arizona.
    </p>
    <ul>
      {/* CONFIGURE_ME: confirm these URLs match the current UA Marcom-approved
          privacy + accessibility statements before launch. */}
      <li><a href="https://www.arizona.edu/privacy">Privacy</a></li>
      <li><a href="https://www.arizona.edu/information-accessibility">Accessibility</a></li>
      <li><a href="https://www.arizona.edu/">The University of Arizona</a></li>
    </ul>
  </div>
</footer>

<style>
  .ua-footer {
    background: var(--surface);
    color: var(--text);
    border-top: 1px solid var(--border);
    font-family: var(--font-sans);
  }

  .ua-footer__inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-8);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-8) var(--space-6);
  }

  .ua-footer__wordmark {
    font-weight: var(--font-weight-extrabold);
    color: var(--text-strong);
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-2);
  }
  .ua-footer__desc {
    color: var(--text-muted);
    margin: 0;
  }

  .ua-footer__columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .ua-footer__col h4 {
    font-size: 0.75rem; /* 12px */
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
  }
  .ua-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .ua-footer__col a {
    color: var(--text);
    text-decoration: none;
  }
  .ua-footer__col a:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  .ua-footer__legal {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem; /* 14px */
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    max-width: var(--container-wide);
    margin-inline: auto;
  }
  .ua-footer__legal p {
    margin: 0;
  }
  .ua-footer__legal ul {
    list-style: none;
    display: inline-flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }
  .ua-footer__legal a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .ua-footer__legal a:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .ua-footer__inner {
      grid-template-columns: 1fr;
      padding: var(--space-6) var(--space-4);
    }
    .ua-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
