---
// ThemeToggle — cycle-button style. Three states: system → light → dark.
// Persists to localStorage under "ua-theme". FOUC-safe (the bootstrap in
// BaseLayout already set data-theme on <html> before this script ran).
// Tokens used: --surface-alt, --text, --text-strong, --accent, --border,
// --radius-pill, --focus-ring.
// Contract: docs/COMPONENTS.md#themetoggle
---

<button
  type="button"
  class="ua-theme-toggle"
  aria-label="Theme: system. Activate to switch."
  data-ua-theme-toggle
>
  <span class="ua-theme-toggle__icon" aria-hidden="true" data-icon>
    {/* Inline SVG fallback — the script swaps stroke/fill via currentColor. */}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
  </span>
  <span class="ua-theme-toggle__label" data-label>System</span>
</button>

<style>
  .ua-theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--surface-alt);
    color: var(--text-strong);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }
  .ua-theme-toggle:hover {
    border-color: var(--border-strong);
  }
  .ua-theme-toggle__icon {
    display: inline-flex;
    align-items: center;
  }
</style>

<script>
  // Runs on every page (Astro hoists this script and de-dupes it across pages
  // that mount the same component). Uses the same key + dataset attributes as
  // the inline bootstrap in BaseLayout. See docs/DARK_MODE.md.
  import { setTheme, watchSystemTheme, type ThemeMode } from "../lib/theme";

  const MODES: readonly ThemeMode[] = ["system", "light", "dark"] as const;
  const LABELS: Record<ThemeMode, string> = {
    system: "System",
    light: "Light",
    dark: "Dark",
  };

  function nextMode(current: ThemeMode): ThemeMode {
    const i = MODES.indexOf(current);
    const next = MODES[(i + 1) % MODES.length];
    // Narrow back to ThemeMode; the modulo guarantees a defined value.
    return next ?? "system";
  }

  function currentMode(): ThemeMode {
    const raw = document.documentElement.dataset.themeMode;
    if (raw === "system" || raw === "light" || raw === "dark") {
      return raw;
    }
    return "system";
  }

  function render(button: HTMLButtonElement, mode: ThemeMode): void {
    const label = button.querySelector<HTMLElement>("[data-label]");
    if (label) label.textContent = LABELS[mode];
    button.setAttribute(
      "aria-label",
      `Theme: ${LABELS[mode].toLowerCase()}. Activate to switch.`,
    );
  }

  function init(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "[data-ua-theme-toggle]",
    );
    buttons.forEach((button) => {
      render(button, currentMode());
      button.addEventListener("click", () => {
        const mode = nextMode(currentMode());
        setTheme(mode);
        buttons.forEach((b) => render(b, mode));
      });
    });

    // While in `system` mode, follow OS-level changes live.
    watchSystemTheme();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
