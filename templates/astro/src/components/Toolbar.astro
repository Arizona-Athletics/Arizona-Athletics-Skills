---
// Toolbar — secondary action bar under the hero on app/dashboard pages.
// Tokens used: --surface-alt, --surface, --text-strong, --text, --accent,
// --border, --radius-pill, --shadow-sm, --space-3, --space-4.
// Contract: docs/COMPONENTS.md#toolbar

interface FilterChip {
  label: string;
  pressed?: boolean;
}

interface Props {
  title?: string;
  filters?: FilterChip[];
  sticky?: boolean;
}

const {
  title = "Schedule",
  filters = [
    { label: "All", pressed: true },
    { label: "Football" },
    { label: "Basketball" },
    { label: "Baseball" },
  ],
  sticky = false,
} = Astro.props;
---

<div
  class:list={["ua-toolbar", { "ua-toolbar--sticky": sticky }]}
>
  <div class="ua-toolbar__title">
    <h2>{title}</h2>
  </div>

  <div
    class="ua-toolbar__filters"
    role="group"
    aria-label="Filter by sport"
  >
    {
      filters.map((chip) => (
        <button
          type="button"
          class:list={["ua-chip", { "is-active": chip.pressed }]}
          aria-pressed={chip.pressed ? "true" : "false"}
        >
          {chip.label}
        </button>
      ))
    }
  </div>

  <div class="ua-toolbar__actions">
    <slot name="actions">
      <button type="button" class="ua-btn ua-btn--ghost">Export</button>
      <button type="button" class="ua-btn ua-btn--primary">Add Game</button>
    </slot>
  </div>
</div>

<style>
  .ua-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: var(--surface-alt);
    border-bottom: 1px solid var(--border);
    padding: 0 var(--space-5);
    min-height: 56px;
  }
  .ua-toolbar--sticky {
    position: sticky;
    top: 64px;
    z-index: 40;
    box-shadow: var(--shadow-sm);
  }

  .ua-toolbar__title h2 {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-semibold);
    color: var(--text-strong);
    font-size: var(--font-size-h4);
    margin: 0;
  }

  .ua-toolbar__filters {
    display: inline-flex;
    gap: var(--space-2);
    flex: 1;
  }

  .ua-chip {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }
  .ua-chip:hover {
    color: var(--text-strong);
  }
  .ua-chip.is-active {
    background: var(--accent);
    color: var(--ua-white);
    border-color: var(--accent);
  }

  .ua-toolbar__actions {
    display: inline-flex;
    gap: var(--space-3);
  }

  @media (max-width: 767px) {
    .ua-toolbar {
      flex-wrap: wrap;
      padding: var(--space-3) var(--space-4);
    }
  }
</style>
