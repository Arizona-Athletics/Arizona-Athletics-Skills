---
// Hero — page-top banner. Headline, optional subhead, optional CTA.
// Tokens used: --bg, --surface, --text-strong, --text-muted, --accent,
// --font-sans, --space-6, --space-8, --radius-md.
// Contract: docs/COMPONENTS.md#hero

interface Props {
  variant?: "default" | "compact" | "with-image";
  headline: string;
  subhead?: string;
  align?: "start" | "center";
}

const {
  variant = "default",
  headline,
  subhead,
  align = "start",
} = Astro.props;
---

<section
  class:list={[
    "ua-hero",
    `ua-hero--${variant}`,
    `ua-hero--align-${align}`,
  ]}
  aria-labelledby="hero-title"
>
  <div class="ua-hero__content">
    <h1 id="hero-title" class="ua-hero__headline">{headline}</h1>
    {subhead ? <p class="ua-hero__subhead">{subhead}</p> : null}
    <div class="ua-hero__cta">
      <slot name="cta">
        <a class="ua-btn ua-btn--primary" href="#">Get Started</a>
        <a class="ua-btn ua-btn--ghost" href="#">Learn More</a>
      </slot>
    </div>
  </div>
</section>

<style>
  .ua-hero {
    background: var(--surface);
    color: var(--text);
    padding: var(--space-12) var(--space-6);
  }
  .ua-hero--compact {
    padding: var(--space-8) var(--space-6);
  }
  .ua-hero--with-image {
    /* CONFIGURE_ME: set a background-image and rely on the brand scrim below.
       The scrim alone keeps text legible until a real image lands.
       Colors driven through @ua/ua-tokens via color-mix so the scrim is the
       canonical UA Blue / UA Red, never a drifting hex. The exact opacities
       (0.85 / 0.6) come from docs/COMPONENTS.md#hero. */
    background-image: linear-gradient(
      135deg,
      color-mix(in srgb, var(--ua-blue) 85%, transparent),
      color-mix(in srgb, var(--ua-red) 60%, transparent)
    );
    color: var(--ua-white);
    min-height: 320px;
  }

  .ua-hero--align-center .ua-hero__content {
    text-align: center;
    margin-inline: auto;
  }

  .ua-hero__content {
    max-width: var(--container-default);
    margin-inline: auto;
  }

  .ua-hero__headline {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--font-size-h1);
    line-height: var(--line-height-tight);
    color: var(--text-strong);
    margin: 0 0 var(--space-3);
  }
  .ua-hero--with-image .ua-hero__headline {
    /* On the scrim, force the bright reverse for AA contrast. */
    color: var(--ua-white);
  }

  .ua-hero__subhead {
    font-family: var(--font-sans);
    font-size: var(--font-size-h4);
    color: var(--text-muted);
    margin: 0 0 var(--space-5);
    max-width: 56ch;
  }
  .ua-hero--align-center .ua-hero__subhead {
    margin-inline: auto;
  }
  .ua-hero--with-image .ua-hero__subhead {
    /* AA-compliant reverse text on the brand scrim — driven via tokens. */
    color: color-mix(in srgb, var(--ua-white) 92%, transparent);
  }

  .ua-hero__cta {
    display: inline-flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Button styles are scoped here so the demo page works without an external
     button system. A real project may move these into a shared button module. */
  :global(.ua-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
  }
  :global(.ua-btn--primary) {
    background: var(--accent);
    color: var(--ua-white);
  }
  :global(.ua-btn--primary:hover) {
    background: var(--accent-hover);
  }
  :global(.ua-btn--ghost) {
    background: transparent;
    color: var(--text-strong);
    border-color: var(--border-strong);
  }
  :global(.ua-btn--ghost:hover) {
    background: var(--surface-alt);
  }
</style>
