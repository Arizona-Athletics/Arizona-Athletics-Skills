# UA Athletics — Astro template environment
#
# Copy to `.env` (gitignored) and fill in the values from your project's AWS
# console and the UA IT engagement ticket. NEVER commit `.env`. NEVER put
# `COGNITO_CLIENT_SECRET` in a PUBLIC_-prefixed variable — that ships in the
# browser bundle. See ../../docs/AUTH.md.
#
# `PUBLIC_` prefix exposes the variable to the client bundle. Cognito SPAs
# (PKCE) only need public values; the client_secret is for confidential
# server clients (Next.js / Express) and stays unprefixed and server-only.

# AWS / Cognito User Pool                                     # CONFIGURE_ME
PUBLIC_AWS_REGION=us-west-2
PUBLIC_COGNITO_DOMAIN=your-app-name                            # subdomain of {region}.amazoncognito.com
PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx            # public app client (no secret)
PUBLIC_COGNITO_REDIRECT_URI=http://localhost:4321/auth/callback
PUBLIC_COGNITO_LOGOUT_URI=http://localhost:4321/

# SAML IdP name as configured in Cognito                      # CONFIGURE_ME
PUBLIC_COGNITO_SAML_PROVIDER_NAME=UAWebAuth

# Adobe Typekit kit ID (Proxima Nova + Garamond Premier Pro)  # CONFIGURE_ME
# Wire into BaseLayout.astro's <link> tag once Marcom has cleared the domain.
PUBLIC_TYPEKIT_ID=

# Server-side only. NEVER commit. NEVER expose to the client bundle.
# This Astro template uses PKCE (no client_secret). Leave blank unless you
# switch the template to `output: "server"` AND add a confidential client.
COGNITO_CLIENT_SECRET=
