# UA Athletics — React + Vite+ template environment.
#
# Copy this file to `.env` and fill in values from your AWS console and the
# UA IT engagement ticket. `.env` is gitignored; never commit real values.
#
# Vite exposes ONLY variables prefixed `VITE_` to the client bundle. SPAs use
# the PKCE OAuth flow, which does NOT require a client secret.
#
# Reference: docs/AUTH.md

# AWS / Cognito User Pool (CONFIGURE_ME)
VITE_COGNITO_REGION=us-west-2
VITE_COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_DOMAIN=your-app-name
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# SAML IdP name as configured in Cognito (CONFIGURE_ME)
VITE_COGNITO_SAML_PROVIDER_NAME=UAWebAuth

# Adobe Typekit kit ID (CONFIGURE_ME)
VITE_TYPEKIT_KIT_ID=your-app-name
