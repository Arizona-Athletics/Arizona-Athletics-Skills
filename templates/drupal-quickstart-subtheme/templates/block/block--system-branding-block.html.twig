{#
/**
 * @file
 * Theme override for the System Branding block.
 *
 * Renders the UA Athletics lockup per /.claude/research/ua-design-spec-2026-05-22.md §6:
 *   - Block A on opaque white substrate (the SVG already includes the substrate).
 *   - Minimum 27px web (we ship at 48px in the brand band, 96px on a fresh page).
 *   - "Arizona Athletics" word lockup to the right of the mark.
 *   - Never recolored, stretched, used as a letter, or placed on a colored
 *     background without its white substrate.
 *
 * The site_logo / site_name / site_slogan variables are ignored on purpose —
 * Athletics sites use the licensed Block A asset shipped with this subtheme,
 * not the Drupal site logo upload. CONFIGURE_ME: replace
 * /images/block-a.svg with the approved Athletics-licensed SVG from UA Marcom
 * before launch.
 *
 * Available variables (kept for reference):
 * - site_logo: Logo for site as defined in theme settings.
 * - site_name: Name for site as defined in Drupal config.
 * - site_slogan: Slogan for site as defined in Drupal config.
 */
#}
{% set base = base_path ~ directory %}

<a href="{{ url('<front>') }}"
   class="d-inline-flex align-items-center text-decoration-none link-body-emphasis"
   rel="home"
   aria-label="{{ site_name ?: 'Arizona Athletics'|t }} {{ 'home'|t }}">
  <img src="{{ base }}/images/block-a.svg"
       alt=""
       width="48"
       height="48"
       class="me-2"
       loading="eager">
  <span class="fs-4 fw-bold">{{ site_name ?: 'Arizona Athletics'|t }}</span>
</a>
