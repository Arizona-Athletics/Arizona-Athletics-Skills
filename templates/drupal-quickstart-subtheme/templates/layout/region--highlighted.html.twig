{#
/**
 * @file
 * Theme override for the Highlighted region — repurposed as the UA Athletics
 * hero band.
 *
 * Wraps whatever blocks the site-builder places in `highlighted` with the
 * canonical hero frame from docs/COMPONENTS.md § Hero:
 *
 *   <section class="background-wrapper text-bg-red bg-triangles-top-left">
 *     <div class="container py-5 my-5">
 *       <div class="row">
 *         <div class="col-lg-7"> … </div>
 *       </div>
 *     </div>
 *   </section>
 *
 * If the region is empty, fall back to the Bear Down hero so a fresh install
 * always lands on something on-brand.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <section>.
 * - region: The name of the region.
 */
#}
<section class="background-wrapper text-bg-red bg-triangles-top-left">
  <div class="container py-5 my-5">
    <div class="row">
      <div class="col-lg-7">
        {% if content %}
          {{ content }}
        {% else %}
          <h1 class="display-2 fw-light">{{ 'Bear Down. Build Up.'|t }}</h1>
          <p class="lead mb-4">
            {{ 'Be the next chapter in 140+ years of Wildcat resolve.'|t }}
          </p>
          <a href="#tickets" class="btn btn-outline-white btn-lg me-2">{{ 'Buy Tickets'|t }}</a>
          <a href="#schedule" class="btn btn-outline-white btn-lg">{{ '2026 Schedule'|t }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
