{#
/**
 * @file
 * Theme override for the Footer first region — the brand/address column
 * (col 1 of the 5-column footer).
 *
 * Renders a Block A on white substrate + address + copyright if the region is
 * empty, otherwise renders the placed blocks as-is.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region wrapper.
 * - region: The name of the region.
 */
#}
{% if content %}
  {{ content }}
{% else %}
  <a href="/" class="d-flex align-items-center mb-3 link-body-emphasis text-decoration-none"
     aria-label="{{ 'Arizona Athletics'|t }}">
    <img src="/{{ directory }}/images/block-a.svg" alt="" width="48" height="48" class="me-2">
    <span class="fs-5 fw-bold">{{ 'Arizona Athletics'|t }}</span>
  </a>
  <p class="text-body-secondary small mb-0">
    {{ 'The University of Arizona'|t }}<br>{{ 'Tucson, AZ 85721'|t }}
  </p>
  <p class="text-body-secondary small">
    &copy; {{ 'now'|date('Y') }} {{ 'Arizona Board of Regents'|t }}
  </p>
{% endif %}
