{#
/**
 * @file
 * Theme override for the canonical Arizona red header region.
 *
 * In most installs the red bar is rendered directly in page.html.twig and this
 * region holds secondary header items (alerts, promo banners). When a
 * site-builder DOES place blocks in `header`, wrap them in a token-clean
 * container so they sit cleanly under the red bar.
 *
 * Per /.claude/research/ua-design-spec-2026-05-22.md §1:
 *   - Wordmark via CDN URL — never local.
 *   - Default `bg-red`. Blue variant only on marcom-approved subdomains.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region (e.g. 'header').
 */
#}
{% if content %}
  {%
    set classes = [
      'region',
      'region-' ~ region|clean_class,
      'bg-white',
      'border-bottom',
      'py-2',
    ]
  %}
  <div{{ attributes.addClass(classes) }}>
    <div class="container">
      {{ content }}
    </div>
  </div>
{% endif %}
