# @ua/template-html-tailwind — Cognito + UA SAML
#
# Copy to `.env` (gitignored). Fill in via your project's AWS Console + the
# UA IT engagement process. NEVER commit real values to git.
# See /docs/AUTH.md for the full flow shape and rules.
#
# This template ships as a static HTML+Tailwind site with no server runtime,
# so these values are reference only — the SPA reads its config from auth.js,
# where they are intentionally placeholders. Wire them into your deployment
# (server-side template inject, build-time replace, or runtime config.json
# fetched same-origin) rather than baking real IDs into a committed file.

# --- AWS / Cognito User Pool ----------------------------------------- CONFIGURE_ME
AWS_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=your-app-name
COGNITO_REDIRECT_URI=http://localhost:8081/auth/callback
COGNITO_LOGOUT_URI=http://localhost:8081/

# --- UA SAML provider name as configured in Cognito ----------------- CONFIGURE_ME
COGNITO_SAML_PROVIDER_NAME=UAWebAuth

# --- Adobe Typekit kit ID -------------------------------------------- CONFIGURE_ME
# Email web@arizona.edu for UA Marcom Typekit clearance before pointing a new
# domain at a shared kit. See /docs/TYPOGRAPHY.md.
TYPEKIT_KIT_ID=your-app-name

# --- Server-only secret. DO NOT expose to the browser. -------------- CONFIGURE_ME
# This SPA template uses PKCE and SHOULD NOT have a client secret.
# Only fill in for a confidential server-side companion (e.g. Express, Next route handlers).
COGNITO_CLIENT_SECRET=
