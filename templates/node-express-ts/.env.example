# UA Athletics — Node + Express + TypeScript template environment.
#
# Copy this file to `.env` and fill in real values from your AWS console and
# the UA IT engagement ticket. `.env` is gitignored — never commit real values.
#
# Server-rendered apps use the Authorization Code grant with a confidential
# client. The Cognito client secret is loaded server-side ONLY and must never
# ship to the browser bundle. See /docs/AUTH.md.

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Express session
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=CONFIGURE_ME_session_secret_min_32_chars
SESSION_COOKIE_NAME=ua.sid
# `true` only behind HTTPS (production / Cloudflare / ALB). `false` for local dev.
SESSION_COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# AWS / Cognito User Pool   (CONFIGURE_ME)
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
COGNITO_USER_POOL_ID=CONFIGURE_ME
COGNITO_CLIENT_ID=CONFIGURE_ME
COGNITO_DOMAIN=CONFIGURE_ME
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/

# Server-side ONLY. Never expose to the browser bundle.
COGNITO_CLIENT_SECRET=CONFIGURE_ME

# ─────────────────────────────────────────────────────────────────────────────
# SAML IdP name as configured in Cognito  (CONFIGURE_ME)
# Cognito routes federated logins to the UA SAML IdP using this identity
# provider name. UA IT issues the IdP-side metadata; this string maps to it on
# the Cognito side.
# ─────────────────────────────────────────────────────────────────────────────
COGNITO_SAML_PROVIDER_NAME=CONFIGURE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Adobe Typekit kit ID  (CONFIGURE_ME)
# Each UA unit licenses its own kit. Document the swap with Marcom before
# pushing to production. See /docs/TYPOGRAPHY.md.
# ─────────────────────────────────────────────────────────────────────────────
TYPEKIT_KIT_ID=CONFIGURE_ME
