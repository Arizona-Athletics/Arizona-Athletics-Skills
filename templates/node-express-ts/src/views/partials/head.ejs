<!doctype html>
<html lang="en" data-theme="<%= theme %>" data-bs-theme="<%= theme %>" data-theme-mode="<%= themeMode %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : appName %> &middot; Arizona Athletics</title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'The official home of Arizona Wildcats Athletics — Bear Down. Build Up.' %>" />

  <!--
    FOUC-safe pre-paint script. MUST run BEFORE any stylesheet so the user
    never sees a flash of the wrong theme. Kept in ES5 (no arrow/const) so
    it parses on any browser without transpilation. CSP nonce is per-request.
  -->
  <script nonce="<%= cspNonce %>">
    (function () {
      try {
        var stored = localStorage.getItem("ua-theme");
        var mode = stored || "system";
        var resolved = mode === "system"
          ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          : mode;
        var html = document.documentElement;
        html.dataset.theme = resolved;
        html.dataset.bsTheme = resolved;
        html.dataset.themeMode = mode;
        // Sync a cookie so server-rendered markup matches on the next request.
        document.cookie = "ua-theme=" + resolved + "; path=/; max-age=" + (60 * 60 * 24 * 365) + "; samesite=lax";
      } catch (e) {
        document.documentElement.dataset.theme = "light";
      }
    })();
  </script>

  <!-- Arizona Bootstrap 5.1.3 — official UA CDN. NOT on npm. Load from cdn.digital.arizona.edu. -->
  <link
    rel="stylesheet"
    href="https://cdn.digital.arizona.edu/lib/arizona-bootstrap/5.1.3/css/arizona-bootstrap.min.css"
  />

  <!-- Material Symbols Rounded — used by the canonical Arizona header. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
    rel="stylesheet"
  />

  <!-- Adobe Typekit (Proxima Nova). Each UA unit licenses its own kit. CONFIGURE_ME in .env. -->
  <% if (typekitKitId && typekitKitId !== 'CONFIGURE_ME') { %>
    <link rel="stylesheet" href="https://use.typekit.net/<%= typekitKitId %>.css" />
  <% } %>

  <!--
    @ua/ua-tokens emitted CSS. This must come BEFORE app.css so project tweaks
    can reference the semantic variables (--bg, --surface, --text, --accent).
    Mounted by server.ts at /static/ua-tokens/ → packages/ua-tokens/dist/.
  -->
  <link rel="stylesheet" href="/static/ua-tokens/tokens.css" />

  <!-- Project-local UA tweaks (semantic / Arizona Bootstrap CSS vars only — zero hex). -->
  <link rel="stylesheet" href="/static/styles/app.css" />

  <!-- Favicon: placeholder Block A. Swap for licensed asset before production. -->
  <link rel="icon" type="image/svg+xml" href="/static/img/block-a.svg" />
</head>
<body>
  <a class="visually-hidden-focusable bg-white text-red p-2" href="#main">Skip to content</a>
