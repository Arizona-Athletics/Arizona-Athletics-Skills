{
  "name": "@ua/template-node-express-ts",
  "version": "0.1.0",
  "description": "University of Arizona Athletics starter — Node 22 + Express 5 + TypeScript + EJS + Arizona Bootstrap CDN.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cp -R src/views dist/views",
    "start": "node dist/server.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@ua/ua-tokens": "workspace:*",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
