{
  "name": "arizona-athletics-skills",
  "version": "0.1.0",
  "description": "Shared design system + starter templates for University of Arizona Athletics web projects.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "check": "bun run --filter './packages/*' check",
    "check:compliance": "bun scripts/check-compliance.ts",
    "check:skills": "bun scripts/check-skills.ts",
    "check:bundle": "bun scripts/check-skills.ts --bundle-only",
    "check:contrast": "bun scripts/check-contrast.ts",
    "clean": "bun run --filter './packages/*' clean",
    "sync:template-token-vendors": "bun scripts/sync-template-token-vendors.ts",
    "check:template-token-vendors": "bun scripts/sync-template-token-vendors.ts --check",
    "check:token-dist": "bun scripts/check-token-dist.ts",
    "check:standalone-templates": "bun scripts/check-standalone-templates.ts",
    "install:agent-skills": "bun scripts/install-agent-skills.ts",
    "install:agent-skill-bundle": "bun scripts/build-agent-skill-bundle.ts && bun scripts/install-agent-skills.ts --bundle-only",
    "build:agent-skill-bundle": "bun scripts/build-agent-skill-bundle.ts",
    "sync:project-skills": "bun scripts/install-agent-skills.ts --project-only",
    "build:claude-web-skill": "bun scripts/build-agent-skill-bundle.ts && bun scripts/package-claude-web-skill.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
